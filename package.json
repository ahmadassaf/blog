{
  "name": "ahmad-assaf-webspace",
  "version": "1.0.0",
  "repository": "https://github.com/ahmadassaf/blog",
  "private": true,
  "scripts": {
    "content": "mkdir -p ./app/content &&  NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 contentlayer2 build -c contentlayer.config.js && node ./scripts/build.mjs",
    "start": "mkdir -p ./app/content &&  NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 cross-env INIT_CWD=$PWD next dev --turbopack",
    "dev": "mkdir -p ./app/content && NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 cross-env INIT_CWD=$PWD next dev --turbopack",
    "build": "mkdir -p ./app/content && mkdir -p ./public && NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 cross-env INIT_CWD=$PWD contentlayer2 build -c contentlayer.config.js && node ./scripts/build.mjs && next build",
    "serve": "cross-env INIT_CWD=$PWD next start",
    "analyze": "cross-env INIT_CWD=$PWD ANALYZE=true next build",
    "lint": "cross-env INIT_CWD=$PWD next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "prepare": "husky install",
    "pull": "git subtree pull --prefix data/blog git@github.com:ahmadassaf/blog-posts.git master --squash",
    "push": "git subtree push --prefix data/blog git@github.com:ahmadassaf/blog-posts.git master"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.2.2",
