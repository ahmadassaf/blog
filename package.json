{
  "name": "ahmad-assaf-webspace",
  "version": "1.0.0",
  "repository": "https://github.com/ahmadassaf/blog",
  "private": true,
  "scripts": {
    "content:checkout": "git submodule update --init --recursive data/blog",
    "content:update": "git submodule update --remote --recursive data/blog",
    "content": "pnpm content:checkout && NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 contentlayer2 build -c contentlayer.config.js && node ./scripts/build.mjs",
    "start": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 cross-env INIT_CWD=\"$PWD\" contentlayer2 build -c contentlayer.config.js && node ./scripts/build.mjs && cross-env INIT_CWD=\"$PWD\" next dev --turbopack",
    "dev": "pnpm content:checkout && NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 cross-env INIT_CWD=\"$PWD\" contentlayer2 build -c contentlayer.config.js && node ./scripts/build.mjs && next dev --turbopack",
    "dev:no-github": "cross-env SKIP_GITHUB_API=true pnpm dev",
    "build": "pnpm content:checkout && NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 cross-env INIT_CWD=\"$PWD\" contentlayer2 build -c contentlayer.config.js && node ./scripts/build.mjs && next build",
    "build:no-github": "cross-env SKIP_GITHUB_API=true pnpm build",
    "storybook": "pnpm --dir ../design-system storybook",
    "storybook:build": "pnpm --dir ../design-system build-storybook",
    "test:ds-contracts": "pnpm --dir ../design-system test:contracts",
    "test": "node --test $(find lib data/blog/visualisations -name '*.test.*' | sort)",
    "serve": "cross-env INIT_CWD=\"$PWD\" next start",
    "analyze": "cross-env INIT_CWD=\"$PWD\" ANALYZE=true next build",
    "lint": "pnpm lint:check --fix",
    "lint:check": "cross-env INIT_CWD=\"$PWD\" eslint app layouts lib scripts tailwind.config.js next.config.js postcss.config.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "@gaudi/design-system": "github:ahmadassaf/design-system#0a047d044f25d6b774f4397256e05b2f3efb0e56",
    "@giscus/react": "^3.1.0",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/postcss": "^4.1.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/og": "^0.6.8",
    "@vercel/speed-insights": "^1.2.0",
    "citation-js": "^0.7.20",
    "clsx": "^2.1.1",
    "contentlayer2": "^0.5.5",
    "cookies-next": "^5.1.0",
    "esbuild": "^0.25.3",
    "framer-motion": "^12.9.2",
    "image-size": "^2.0.2",
    "katex": "^0.18.1",
    "lucide-react": "^0.544.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.12.0",
    "mini-svg-data-uri": "^1.4.4",
    "next": "15.5.9",
    "next-contentlayer2": "^0.5.5",
    "next-themes": "^0.4.6",
    "node-html-parser": "^7.0.1",
    "octokit": "^4.1.3",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "reading-time": "^1.5.0",
    "recharts": "^3.10.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-code-group-next": "^0.3.1",
    "rehype-katex": "^7.0.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-emoji": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.1",
    "shiki": "^3.3.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.4",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@next/bundle-analyzer": "^15.3.1",
    "@next/eslint-plugin-next": "^15.3.1",
    "@svgr/webpack": "^8.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-sort-requires-by-path": "^1.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@8.15.2"
}
